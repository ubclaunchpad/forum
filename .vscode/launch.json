            "name": "Debug Run Server Tests",
            "type": "node",
            "cwd": "${workspaceFolder}/server",
            "env": {},
            "runtimeExecutable": "/opt/homebrew/bin/deno",
            "runtimeArgs": [
                "test",
                "--allow-all",
                "--coverage",
                "--env-file=./.env.local"
            ],
            "console": "integratedTerminal",
            "attachSimplePort": 9229,
            "postDebugTask": "Generate Coverage Report"
